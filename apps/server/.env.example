# 复制本文件为 .env 并按需修改
# PostgreSQL 连接串
# - 本地用本仓库 docker-compose.yml 时，宿主机端口是 55432（注意不是 5432）：
#   postgresql://cloth:cloth@localhost:55432/cloth_scan?schema=public
DATABASE_URL="postgresql://cloth:cloth@localhost:55432/cloth_scan?schema=public"

# 服务端口
PORT=3000

# JWT 密钥：服务启动会强校验，必须配置且长度 ≥ 32 字符，否则启动失败。
# 生产请改为随机长字符串（如 openssl rand -hex 32 的输出）。
JWT_SECRET="dev-local-secret-change-in-prod-32+"

# 注册邀请码：控制谁能注册门店。
# - 不设置 = 关闭注册（任何人都注册不了）。
# - 本地若要测试注册，填任意码；告诉信任的人才能在 App 注册。
REGISTER_CODE="dev-invite-code"
